OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_PREDICT=3072
# auto | finance | generic — доменные эвристики постобработки тестов (см. AITestGenerator._finance_heuristics_enabled)
# AI_TEST_HEURISTICS_PROFILE=auto
# Pytest repair loop (ARCHIVE + pytest): 1|0, раунды, таймаут/размер вывода, лимит AST-digest в промпте
# AI_PYTEST_REPAIR=1
# AI_PYTEST_REPAIR_ROUNDS=2
# AI_PYTEST_TIMEOUT_SEC=120
# AI_PYTEST_OUTPUT_MAX=14000
# AI_CONTRACT_DIGEST_CHARS=4500
# OLLAMA_NUM_PREDICT_REPAIR=4096
# LLM as assistant only (default off). When off: advanced/full use deterministic recipe/AST generator.
# AI_LLM_ASSIST_DEFAULT=0
# Recipe profile for deterministic generator: auto|generic|finance
# AI_RECIPE_PROFILE=auto
# Статические issues по print: при «консольном» модуле (>= N print, CLI-фреймворк или типовое имя файла)
# выдаётся одно сводное замечание print_production_hint вместо десятков print_debug по строкам.
# AI_ISSUES_PRINT_CONSOLE_MIN=3
# Часовой пояс для Celery Beat (очистка неактивных сессий в 00:00 и 12:00 по этому TZ)
# CELERY_TIMEZONE=UTC
# CELERY_TIMEZONE=Europe/Moscow
