# Скопируйте в .env перед демо на защите (опционально)
# cp .env.demo.example .env

# Ollama: для слабого ПК отключите LLM — только рецепты/basic
OLLAMA_MODEL=qwen2.5-coder:7b
# AI_LLM_ASSIST_DEFAULT=0

# Tuna: фиксированный субдомен для защиты
# TUNA_SUBDOMAIN=python-test-gen
# Публичный URL: https://python-test-gen.tuna.am

# Часовой пояс для Celery
CELERY_TIMEZONE=Europe/Moscow

# Параллельные задачи (анализ/генерация разных сессий одновременно).
# Для слабого ПК уменьшите до 2; для защиты с несколькими зрителями — 4.
# CELERY_WORKER_CONCURRENCY=4
# OLLAMA_NUM_PARALLEL=2
